---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 16"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-label="Bandera de Estados Unidos"
>
  <clipPath id="us-flag-clip"><rect width="24" height="16" rx="2" /></clipPath>
  <g clip-path="url(#us-flag-clip)">
    <rect width="24" height="16" fill="#B22234" />
    <rect y="2.29" width="24" height="2.29" fill="#fff" />
    <rect y="6.86" width="24" height="2.29" fill="#fff" />
    <rect y="11.43" width="24" height="2.29" fill="#fff" />
    <rect width="10" height="8.57" fill="#3C3B6E" />
    <g fill="#fff">
      <circle cx="2.1" cy="1.7" r="0.5" />
      <circle cx="4.9" cy="1.7" r="0.5" />
      <circle cx="7.7" cy="1.7" r="0.5" />
      <circle cx="3.5" cy="3.4" r="0.5" />
      <circle cx="6.3" cy="3.4" r="0.5" />
      <circle cx="2.1" cy="5.1" r="0.5" />
      <circle cx="4.9" cy="5.1" r="0.5" />
      <circle cx="7.7" cy="5.1" r="0.5" />
      <circle cx="3.5" cy="6.8" r="0.5" />
      <circle cx="6.3" cy="6.8" r="0.5" />
    </g>
  </g>
</svg>
