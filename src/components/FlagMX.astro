---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 16"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-label="Bandera de México"
>
  <clipPath id="mx-flag-clip"><rect width="24" height="16" rx="2" /></clipPath>
  <g clip-path="url(#mx-flag-clip)">
    <rect width="8" height="16" fill="#006847" />
    <rect x="8" width="8" height="16" fill="#fff" />
    <rect x="16" width="8" height="16" fill="#CE1126" />
    <circle cx="12" cy="8" r="1.6" fill="none" stroke="#006847" stroke-width="0.4" />
  </g>
</svg>
